# Local card images — hotlinked from TCGPlayer, not needed in repo
*/CARDS/*.webp
*/CARDS/*.jpg
*/CARDS/*.jpeg
*/CARDS/*.png

# Allow gallery images in docs/gallery/
!docs/gallery/*.webp
!docs/gallery/*.jpg
!docs/gallery/*.jpeg
!docs/gallery/*.png

# Inventory CSV — private data, rebuilt daily by Email_Listener
INVENTORY_ALL/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
.venv/
venv/
env/

# Loose images at repo root
*.png
*.jpg
*.jpeg
*.webp

# Claude & editor internals
.claude/
.vscode/
*.lock
